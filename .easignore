# EAS uses this file instead of .gitignore. Keep shared exclusions in sync.
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.pfx
*.key
*.mobileprovision
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
.env
.env.*
/credentials.json
/credentials/
/secrets/
*service-account*.json
*service_account*.json
*google-play*.json
/.npmrc
/.netrc
*.tsbuildinfo
/ios
/android
/.openchamber
/.codex
/.agents
*.apk
*.aab
*.ipa
coverage/

# Build metadata is resolved before upload; the cloud build needs no Git copy.
/.git
/.github

# Public release material stays in GitHub; it is excluded only from EAS uploads.
# Local quality tools run in GitHub CI before the reduced build upload.
/README.md
/docs
/store
/tests
/scripts
/assets/store
