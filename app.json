{
  "expo": {
    "name": "Siphon",
    "slug": "Siphon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.8041q.siphon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Siphon uses your location to show nearby fuel stations.",
        "NSUserTrackingUsageDescription": "Your data is used to keep Siphon free. Enabling tracking lets us show you relevant ads and supports development."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ctr_8041q.siphon"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "6dc8678e-8eb9-4113-a0c5-c1d8bf7a0146"
      }
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "@maplibre/maplibre-react-native",
      [
        "./plugins/withKotlinVersion",
        {
          "kotlinVersion": "2.3.0"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "cmakeVersion": "4.1.2",
            "kotlinVersion": "2.3.0"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "pt",
            "es",
            "fr",
            "de"
          ]
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "Your data is used to keep Siphon free. Enabling tracking lets us show you relevant ads and supports development."
        }
      ],
      "expo-tracking-transparency"
    ],
    "scheme": "siphon",
    "experiments": {
      "typedRoutes": true
    }
  }
}
