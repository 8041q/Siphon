{
  "expo": {
    "name": "Siphon",
    "slug": "Siphon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.8041q.siphon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Siphon uses your location to show nearby fuel stations.",
        "NSUserTrackingUsageDescription": "Siphon uses the advertising identifier, with your permission, to personalize rewarded ads and support the app."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ctr_8041q.siphon"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "6dc8678e-8eb9-4113-a0c5-c1d8bf7a0146"
      }
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "@maplibre/maplibre-react-native",
      "@react-native-vector-icons/ionicons",
      "@react-native-vector-icons/fontawesome",
      "@react-native-vector-icons/material-icons",
      [
        "./plugins/withKotlinVersion",
        {
          "kotlinVersion": "2.3.0"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "cmakeVersion": "3.22.1", //do not change this, or it will break the build
            "kotlinVersion": "2.3.0",
            "extraProguardRules": "-keep class com.google.android.gms.internal.consent_sdk.** { *; }"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "pt",
            "es",
            "fr",
            "de"
          ]
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9869503535733811~5440722415",
          "iosAppId": "ca-app-pub-9869503535733811~6073428605",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "Siphon uses the advertising identifier, with your permission, to personalize rewarded ads and support the app."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Siphon to select an image for your location marker.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-tracking-transparency",
      "expo-iap",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "scheme": "siphon",
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6dc8678e-8eb9-4113-a0c5-c1d8bf7a0146",
      "checkAutomatically": "NEVER"
    }
  }
}
