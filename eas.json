{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_MONETIZATION_ENABLED": "false"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_MONETIZATION_ENABLED": "false"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_MONETIZATION_ENABLED": "false"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-github": {
      "channel": "production-github",
      "environment": "production",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_MONETIZATION_ENABLED": "false"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
