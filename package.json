{
  "name": "siphon",
  "version": "1.0.1",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "markers:generate": "node scripts/generate-station-markers.mjs",
    "markers:check": "node scripts/generate-station-markers.mjs --check",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "doctor": "expo-doctor",
    "export:android": "expo export --platform android",
    "validate:config": "node scripts/validate-release.mjs",
    "prepare:store": "node scripts/prepare-play-store-assets.mjs",
    "validate:store": "node scripts/prepare-play-store-assets.mjs --check",
    "validate:release": "node scripts/validate-release.mjs --release",
    "smoke:api": "node scripts/smoke-api.mjs",
    "build:preview": "eas build --profile preview --platform all",
    "build:production": "eas build --profile production --platform all",
    "update:preview": "eas update --channel preview --environment preview",
    "update:production": "npm run update:play && npm run update:github",
    "build:github": "eas build --profile production-github --platform android",
    "update:play": "eas update --channel production --environment production",
    "update:github": "eas update --channel production-github --environment production"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@maplibre/maplibre-react-native": "^11.3.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-vector-icons/fontawesome": "^13.1.3",
    "@react-native-vector-icons/ionicons": "^13.1.3",
    "@react-native-vector-icons/material-icons": "^13.1.3",
    "@shopify/flash-list": "2.0.2",
    "@xmldom/xmldom": "0.8.15",
    "expo": "~57.0.26",
    "expo-application": "~57.0.2",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.18",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-iap": "^5.5.0",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.24",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-tracking-transparency": "~57.0.2",
    "expo-updates": "~57.0.24",
    "i18next": "^26.3.6",
    "lucide-react-native": "1.50.0",
    "nativewind": "~4.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.1.22",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-mobile-ads": "^16.4.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "expo-doctor": "1.20.4",
    "pngjs": "3.4.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "brace-expansion": "5.0.12"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
